<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playback continues with the screen off, so the service must be a
         foreground service of type mediaPlayback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Copying a library to the drive takes minutes. Without this the process
         can be frozen the moment the app is backgrounded, stopping the copy
         part-way through with nothing to say so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required from API 33 to show the media notification at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading the library from a plugged-in USB drive goes through the
         Storage Access Framework, which needs no storage permission. This is
         only for reading audio already on the phone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Detecting which Bluetooth device we are routed to, for the
         output-aware EQ and queue strategy. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".OtoZineApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OtoZine">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OtoZine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Legacy action: lets Bluetooth headsets and Android Auto
                     discover the session on older surfaces. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name=".library.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
